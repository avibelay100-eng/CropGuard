{
  "name": "cropguard",
  "version": "0.1.0",
  "description": "CropGuard - plant-leaf disease detection platform (monorepo)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared-types",
    "services/ai_engine",
    "apps/server"
  ],
  "scripts": {
    "dev:ai": "npm run dev -w services/ai_engine",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
