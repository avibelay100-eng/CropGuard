# העתיקו את הקובץ הזה ל-.env (באותה תיקייה) ומלאו את הערכים.
# הקובץ .env לא נכנס ל-git.

# --- חובה ---

# כתובת מסד הנתונים PostgreSQL
# פורמט: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://cropguard:change-me@localhost:5432/cropguard?schema=public"

# סוד לחתימת JWT - לפחות 32 תווים אקראיים. ליצירה:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-chars"

# --- רשות (ברירות המחדל מוצגות) ---

# PORT=3000
# AI_ENGINE_URL="http://localhost:8001"
# AI_TIMEOUT_MS=15000
# JWT_EXPIRES_IN_SECONDS=43200
# BCRYPT_ROUNDS=12
# UPLOAD_DIR="uploads"
# MAX_UPLOAD_BYTES=10485760
# CORS_ORIGINS="http://localhost:5173"
# AUTH_RATE_LIMIT=20
# LOG_LEVEL=info

# --- בדיקות ---

# מסד נפרד לבדיקות האינטגרציה. הבדיקות מוחקות בו נתונים!
# בלי המשתנה הזה, בדיקות המסד מדולגות.
# TEST_DATABASE_URL="postgresql://cropguard:change-me@localhost:5432/cropguard_test?schema=public"
