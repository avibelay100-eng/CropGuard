// סכמת מסד הנתונים של CropGuard (PostgreSQL).
// אחרי כל שינוי כאן: "npm run prisma:generate" (קוד TypeScript) ו-"npm run db:migrate" (טבלאות).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // הכתובת מוגדרת ב-prisma.config.ts (משתנה הסביבה DATABASE_URL)
}

/// תפקיד המשתמש במערכת
enum Role {
  /// חקלאי: מנהל חלקות ומעלה תמונות לאבחון
  FARMER
  /// אגרונום: מלווה חקלאים ובודק אבחונים
  AGRONOMIST
  /// מנהל מערכת
  ADMIN
}

/// משתמש במערכת
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  /// גיבוב (hash) של הסיסמה - לעולם לא הסיסמה עצמה
  passwordHash      String
  role              Role      @default(FARMER)
  /// טלפון נייד בפורמט בינלאומי (+9725XXXXXXXX), לשחזור סיסמה; לא חובה
  phone             String?   @unique
  /// מתי הסיסמה שונתה לאחרונה; טוקנים שהונפקו לפני כן נדחים
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  fields     Field[]
  resetCodes PasswordResetCode[]

  @@map("users")
}

/// קוד חד-פעמי לשחזור סיסמה שנשלח ב-SMS
model PasswordResetCode {
  id        String    @id @default(cuid())
  /// HMAC של הקוד - הקוד עצמו לא נשמר
  codeHash  String
  expiresAt DateTime
  /// ניסיונות שגויים; אחרי 5 הקוד נפסל
  attempts  Int       @default(0)
  /// מתי נוצל או נפסל; null = עדיין בתוקף
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_codes")
}

/// ★ התאמה לשוק הישראלי: שיטות הגידול הנפוצות בחקלאות בישראל
enum CultivationMethod {
  /// שטח פתוח
  OPEN_FIELD
  /// בית רשת
  NET_HOUSE
  /// חממה
  GREENHOUSE
  /// מנהרות נמוכות
  TUNNEL
}

/// שיטת ההשקיה של החלקה
enum IrrigationMethod {
  /// טפטוף
  DRIP
  /// המטרה
  SPRINKLER
}

/// חלקה חקלאית של משתמש
model Field {
  id                  String             @id @default(cuid())
  /// שם החלקה, למשל "חממה 3"
  name                String
  /// סוג הגידול, למשל "Tomato" (כמו שם הצמח בתוויות של מודל ה-AI)
  cropType            String
  /// קו רוחב במעלות עשרוניות (-90..90)
  latitude            Float
  /// קו אורך במעלות עשרוניות (-180..180)
  longitude           Float
  /// ★ התאמה לשוק הישראלי: שטח בדונמים (דונם = 1,000 מ"ר); לא חובה
  areaDunams          Float?
  cultivationMethod   CultivationMethod?
  irrigationMethod    IrrigationMethod?
  /// העונה הנוכחית: זן, תאריך שתילה וקטיף צפוי (תאריכים בלבד, בלי שעה)
  variety             String?
  plantingDate        DateTime?          @db.Date
  expectedHarvestDate DateTime?          @db.Date
  /// הערות חופשיות של החקלאי
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  ownerId String
  /// מחיקת משתמש מוחקת גם את החלקות שלו
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  diagnoses Diagnosis[]
  logs      FieldLog[]

  @@index([ownerId])
  @@map("fields")
}

/// סוג הפעולה ביומן השדה
enum FieldLogType {
  /// ריסוס (הדברה) - הפעולה היחידה שיש לה ימי המתנה לקטיף
  SPRAY
  /// דישון
  FERTILIZE
  /// השקיה
  IRRIGATE
}

/// ★ מנגנון ליבה של CropGuard - יומן שדה ו-PHI: רשומה אחת של ריסוס, דישון או השקיה בחלקה
model FieldLog {
  id               String       @id @default(cuid())
  type             FieldLogType
  /// תאריך הביצוע (תאריך בלבד, לפי לוח השנה בישראל)
  appliedOn        DateTime     @db.Date
  /// שם התכשיר המסחרי או הדשן, למשל "Ridomil Gold MZ"
  productName      String?
  /// החומר הפעיל באנגלית, באותיות קטנות (כמו ב-ProductPriceRange)
  activeIngredient String?
  /// מינון לדונם, ביחידה של doseUnit
  dosePerDunam     Float?
  /// יחידת המינון: g, ml, kg, L, m3
  doseUnit         String?
  /// PHI - ימי המתנה לקטיף לפי תווית התכשיר (רק לריסוס)
  phiDays          Int?
  /// התאריך הראשון שבו מותר לקטוף = appliedOn + phiDays. מחושב בשרת, לא מתקבל מהלקוח
  safeHarvestDate  DateTime?    @db.Date
  /// תווית המחלה שבגללה רוססה החלקה (נשמרת גם אם האבחון נמחק)
  modelLabel       String?
  notes            String?
  createdAt        DateTime     @default(now())

  fieldId     String
  /// מחיקת חלקה מוחקת גם את היומן שלה
  field       Field      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  /// האבחון שהוביל לטיפול; מחיקת האבחון משאירה את הרשומה ביומן
  diagnosisId String?
  diagnosis   Diagnosis? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)

  @@index([fieldId, appliedOn])
  @@index([fieldId, safeHarvestDate])
  @@map("field_logs")
}

/// אבחון של תמונת עלה אחת, כפי שהחזיר שירות ה-AI
model Diagnosis {
  id               String   @id @default(cuid())
  /// כתובת או נתיב של תמונת העלה שנשמרה
  imageUrl         String
  /// התווית הגולמית מהמודל, למשל "Tomato___Late_blight"
  modelLabel       String
  /// שם המחלה לתצוגה, למשל "Tomato Late blight"
  diseaseName      String
  /// אחוז הוודאות כהסתברות 0..1 (כמו confidence בתשובת שירות ה-AI)
  confidence       Float
  isHealthy        Boolean
  /// החומר הפעיל שהומלץ, או null (עלה בריא / מחלה בלי טיפול כימי / אי-התאמה לגידול)
  activeIngredient String?
  /// ★ Crop Mismatch Guard: הצמח שהמודל זיהה לא תאם לגידול של החלקה
  cropMismatch     Boolean  @default(false)
  createdAt        DateTime @default(now())

  fieldId String
  /// מחיקת חלקה מוחקת גם את האבחונים שלה
  field   Field  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  /// טיפולים ביומן השדה שנרשמו בעקבות האבחון
  logs FieldLog[]

  @@index([fieldId, createdAt])
  @@index([modelLabel])
  @@map("diagnoses")
}

/// ★ התאמה לשוק הישראלי: טווח מחירים בשקלים של מוצר מסחרי לפי חומר פעיל (מילון המחירים)
model ProductPriceRange {
  id               String   @id @default(cuid())
  /// שם החומר הפעיל באנגלית, באותיות קטנות, למשל "mancozeb"
  activeIngredient String
  /// שם המוצר המסחרי, למשל "Dithane M-45"
  productName      String
  /// גודל האריזה שהמחיר מתייחס אליו, למשל "1 kg"
  packageSize      String
  minPriceILS      Decimal  @db.Decimal(10, 2)
  maxPriceILS      Decimal  @db.Decimal(10, 2)
  /// false עד שהמחיר נבדק מול מקור אמיתי (מחירון ספק / חנות)
  isVerified       Boolean  @default(false)
  /// PHI - ימי המתנה לקטיף לפי תווית המוצר. ערך דוגמה (כמו המחיר) - משתנה לפי גידול ויש לאמת מול התווית
  phiDays          Int?
  /// מאיפה הגיע המחיר
  priceSource      String?
  updatedAt        DateTime @updatedAt

  @@unique([activeIngredient, productName, packageSize])
  @@index([activeIngredient])
  @@map("product_price_ranges")
}

/// החומרים הפעילים המומלצים לכל מחלה שהמודל מזהה
model TreatmentRecommendation {
  id                String   @id @default(cuid())
  /// תווית המחלה מהמודל, למשל "Tomato___Late_blight"
  modelLabel        String   @unique
  /// חומרים פעילים מקובלים (שמות כמו ב-ProductPriceRange.activeIngredient); ריק אם אין טיפול כימי
  activeIngredients String[]
  /// false למחלות שאין להן ריפוי כימי (וירוסים, HLB, אסקה)
  chemicalControl   Boolean
  /// הנחיה קצרה בעברית למשתמש
  note              String
  updatedAt         DateTime @updatedAt

  @@map("treatment_recommendations")
}
