{
  "name": "@cropguard/server",
  "version": "0.1.0",
  "description": "CropGuard core backend - Node.js (JavaScript) + Prisma + PostgreSQL",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:show": "tsx scripts/show-db.js",
    "test": "vitest run",
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "promote-admin": "tsx scripts/promote-admin.js",
    "export-demo-data": "tsx scripts/export-demo-data.js",
    "lint": "oxlint --deny-warnings src test scripts prisma"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "vitest": "^4.1.12",
    "oxlint": "^1.94.0"
  },
  "dependencies": {
    "@cropguard/shared-types": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "fast-xml-parser": "^5.12.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  }
}
