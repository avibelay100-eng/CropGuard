{
  "name": "@cropguard/client",
  "version": "0.1.0",
  "description": "CropGuard web app - React + TypeScript + Tailwind (Hebrew, RTL)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings src",
    "test": "vitest run"
  },
  "dependencies": {
    "@cropguard/shared-types": "*",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
